<%- include('partials/header', { title: 'Edit Book' }) %>

<div class="page-header">
  <div class="page-header-inner">
    <h1 class="page-title">Edit Book</h1>
    <p class="page-subtitle">Update the details for "<%= book.title %>"</p>
  </div>
  <a href="/books" class="btn btn-ghost">← Back to Books</a>
</div>

<% if (error) { %>
  <div class="alert alert-error">Cancel <%= error %></div>
<% } %>

<div class="form-container">
  <form action="/books/<%= book._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="book-form">

    <div class="form-grid">
      <!-- Left Column -->
      <div class="form-col">
        <div class="form-group">
          <label for="title">Book Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" value="<%= book.title %>" required class="form-control">
        </div>

        <div class="form-group">
          <label for="author">Author Name <span class="required">*</span></label>
          <input type="text" id="author" name="author" value="<%= book.author %>" required class="form-control">
        </div>

        <div class="form-group">
          <label for="category">Category <span class="required">*</span></label>
          <select id="category" name="category" required class="form-control">
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= book.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Price (₹) <span class="required">*</span></label>
            <input type="number" id="price" name="price" value="<%= book.price %>" min="0" step="0.01" required class="form-control">
          </div>
          <div class="form-group">
            <label for="quantity">Quantity <span class="required">*</span></label>
            <input type="number" id="quantity" name="quantity" value="<%= book.quantity %>" min="0" required class="form-control">
          </div>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="4" class="form-control"><%= book.description %></textarea>
        </div>
      </div>

      <!-- Right Column - Image -->
      <div class="form-col">
        <div class="form-group">
          <label>Book Cover Image</label>
          <div class="upload-zone" id="uploadZone">
            <div class="upload-preview" id="uploadPreview">
              <img src="/uploads/<%= book.image %>" 
                   alt="<%= book.title %>" 
                   id="currentImage"
                   onerror="this.style.display='none'"
                   style="width:100%;height:100%;object-fit:cover;border-radius:8px;">
              <div class="upload-overlay">
                <span> Click to replace</span>
              </div>
            </div>
            <input type="file" id="image" name="image" accept="image/*" class="upload-input" onchange="previewImage(this)">
          </div>
          <small class="form-hint">Leave empty to keep current image</small>
        </div>
      </div>
    </div>

    <div class="form-footer">
      <a href="/books/<%= book._id %>" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Update Book</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
